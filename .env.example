# اتصال دیتابیس (با docker-compose up -d بالا می‌آید)
DATABASE_URL="postgresql://pet_shop:pet_shop@localhost:5432/pet_shop?schema=public"

# کلید رمزنگاری سشن‌های ورود (Auth.js) - یک مقدار تصادفی و طولانی بگذار
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# فقط یکی از این دو را پر کن تا چت هوشمند فعال شود. اگر هر دو خالی باشند، چت پیام می‌دهد که کلید تنظیم نشده.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# درگاه زرین‌پال - مقدار فعلی merchant عمومی sandbox است، برای تولید واقعی با merchant id خودتان جایگزین کنید
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
