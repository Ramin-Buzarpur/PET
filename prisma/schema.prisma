generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum AgeGroup {
  BABY
  ADULT
  SENIOR
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
}

enum WaterType {
  FRESH
  SALT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  FISH
  REPTILE
  RODENT
  OTHER
}

enum PetGender {
  MALE
  FEMALE
  UNKNOWN
}

enum CalendarType {
  JALALI
  GREGORIAN
}

enum BirthPrecision {
  EXACT
  ESTIMATED
}

enum MeasurementType {
  HEIGHT
  WEIGHT
}

enum NotificationKind {
  WELCOME
  PET_WELCOME
  BIRTHDAY
  FIRST_MONTH
  CARD_NUDGE
  BIRTHDAY_NUDGE
  CALENDAR_REMINDER
  COURSE_DONE
  COURSE_NUDGE
}

enum NotificationChannel {
  PANEL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT_MOCK
  SKIPPED
}

enum StoryStatus {
  PUBLISHED
  HIDDEN
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders          Order[]
  enrollments     Enrollment[]
  chatSessions    ChatSession[]
  pets            Pet[]
  calendarTasks   PetCalendarTask[]
  journalUnlock   JournalUnlockMeta?
  notifications   NotificationLog[]
  certificates    Certificate[]
  stories         PetStory[]
  storyReports    StoryReport[]
  chatPetConsents ChatPetConsent[]

  friendlySmsOptIn  Boolean @default(false)
  marketingSmsOptIn Boolean @default(false)
}

model AnimalSection {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  order      Int        @default(0)
  isHelper   Boolean    @default(false)
  categories Category[]
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  order            Int               @default(0)
  sectionId        String
  section          AnimalSection     @relation(fields: [sectionId], references: [id])
  availableFilters String[]
  productTypes     String[]
  products         ProductCategory[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Product {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  description   String
  images        String[]
  brandId       String?
  brand         Brand?            @relation(fields: [brandId], references: [id])
  ageGroup      AgeGroup?
  dogSize       DogSize?
  waterType     WaterType?
  animalSubtype String?
  productType   String?
  createdAt     DateTime          @default(now())
  categories    ProductCategory[]
  variants      ProductVariant[]
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String?
  color         String?
  packageWeight String?
  price         Int
  stock         Int         @default(0)
  orderItems    OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  totalAmount Int
  address     String
  phone       String
  items       OrderItem[]
  payment     Payment?
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  packageId     String?
  coursePackage CoursePackage?  @relation(fields: [packageId], references: [id])
  quantity      Int
  unitPrice     Int
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String        @default("zarinpal")
  authority String?
  refId     String?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CoursePackage {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  species     Species
  description String
  price       Int
  coverImage  String?
  chapters    Chapter[]
  enrollments Enrollment[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
}

model Chapter {
  id            String                   @id @default(cuid())
  packageId     String
  coursePackage CoursePackage            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title         String
  order         Int
  textContent   String
  audioUrl      String?
  videoUrl      String?
  isFreePreview Boolean                  @default(false)
  searchVector  Unsupported("tsvector")?

  @@index([packageId, order])
}

model Enrollment {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  packageId     String
  coursePackage CoursePackage @relation(fields: [packageId], references: [id])
  progress      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  certificate   Certificate?

  @@unique([userId, packageId])
}

model FaqEntry {
  id           String                   @id @default(cuid())
  question     String
  answer       String
  tags         String[]
  searchVector Unsupported("tsvector")?
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  guestId   String?
  title     String        @default("گفتگوی جدید")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Pet {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  name            String?
  species         PetSpecies?
  speciesOther    String?
  breed           String?
  gender          PetGender       @default(UNKNOWN)
  birthDateValue  String?
  birthCalendar   CalendarType?
  birthPrecision  BirthPrecision?
  approxAgeYears  Int?
  approxAgeMonths Int?
  approxAgeAsOf   DateTime?
  photoUrl        String?
  illness         String?
  allergies       String?
  medications     String?
  chatNotes       String?
  membershipCode  String          @unique @default(cuid())
  isArchived      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  measurements   PetMeasurement[]
  cardShares     PetCardShare[]
  journalEntries JournalEntry[]
  calendarTasks  PetCalendarTask[]
  notifications  NotificationLog[]
  chatConsents   ChatPetConsent[]
}

model PetMeasurement {
  id         String          @id @default(cuid())
  petId      String
  pet        Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  type       MeasurementType
  value      Float
  unit       String
  measuredAt DateTime

  @@index([petId, type, measuredAt])
}

model PetCardShare {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  token       String   @unique @default(cuid())
  showPhoto   Boolean  @default(false)
  showSpecies Boolean  @default(false)
  showBreed   Boolean  @default(false)
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String   @id @default(cuid())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  titleCipher String?
  bodyCipher  String
  iv          String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([petId, createdAt])
}

model JournalUnlockMeta {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id])
  salt                   String
  wrappedKeyByPassphrase String
  wrappedKeyByRecovery   String
  createdAt              DateTime @default(now())
}

model PetCalendarTask {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  petId           String?
  pet             Pet?     @relation(fields: [petId], references: [id])
  text            String
  dueAt           DateTime
  hasTime         Boolean  @default(true)
  reminderOffsets Int[]
  createdAt       DateTime @default(now())

  @@index([userId, dueAt])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  petId     String?
  pet       Pet?                @relation(fields: [petId], references: [id])
  kind      NotificationKind
  dedupeKey String              @unique
  channel   NotificationChannel
  status    NotificationStatus
  message   String
  createdAt DateTime            @default(now())
}

model Certificate {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  enrollmentId    String     @unique
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id])
  participantName String
  serialNumber    String     @unique @default(cuid())
  petNameOnCert   String?
  issuedAt        DateTime   @default(now())
}

model PetStory {
  id           String        @id @default(cuid())
  authorUserId String
  author       User          @relation(fields: [authorUserId], references: [id])
  title        String?
  body         String
  status       StoryStatus   @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  reports      StoryReport[]

  @@index([status, createdAt])
}

model StoryReport {
  id             String       @id @default(cuid())
  storyId        String
  story          PetStory     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User         @relation(fields: [reporterUserId], references: [id])
  reason         String
  note           String?
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())

  @@unique([storyId, reporterUserId])
}

model ChatPetConsent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  petId          String
  pet            Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  consentVersion Int      @default(1)
  consentedAt    DateTime @default(now())

  @@unique([userId, petId])
}
